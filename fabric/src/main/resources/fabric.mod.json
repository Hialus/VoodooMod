{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/voodoo",
        "sources": "https://github.com/Hialus/VoodooMod",
        "issues": "https://github.com/Hialus/VoodooMod/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "de.morrien.voodoo.fabric.VoodooFabric"
        ],
        "client": [
            "de.morrien.voodoo.fabric.VoodooFabricClient"
        ]
    },
    "accessWidener": "${mod_id}.accesswidener",
    "mixins": [
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "${fabric_loader_version_range}",
        "fabric-api": "${fabric_version_range}",
        "minecraft": "${fabric_minecraft_version_range}",
        "java": ">=${java_version}",
        "forgeconfigapiport": "${forgeconfigapiport_version_range}"
    },
    "suggests": {
        "patchouli": "*"
    }
}
  